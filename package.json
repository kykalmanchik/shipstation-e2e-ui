{
  "name": "shipstation-e2e-ui",
  "private": true,
  "version": "0.2.0",
  "description": "A local stand-in for the ShipStation UI the sandbox does not have: run a shipment through hold, label, ship and cancel for end-to-end tests.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/serve.mjs",
    "test": "node --test 'test/*.test.mjs' 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "sync-style": "node scripts/sync-os-style.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
