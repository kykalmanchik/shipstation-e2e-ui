# shipstation-e2e-ui — which ShipStation account the app talks to.
# Copy to .env (`cp .env.example .env`), edit, and restart `npm run dev` / `npm start`.
# A variable set in the shell wins over this file (`SHIPSTATION_ENV=production npm run dev` for one run).
# NEVER prefix these names with VITE_: Vite would copy them into the browser bundle.

# sandbox | production
SHIPSTATION_ENV=sandbox

# --- Sandbox --------------------------------------------------------------------------------------------------
# A TEST_ key: ShipStation API dashboard → API keys → Sandbox. Free test labels, nothing real.
SHIPSTATION_SANDBOX_API_KEY=

# --- Production -----------------------------------------------------------------------------------------------
# A live key (no TEST_ prefix). REAL orders, real customers' names and addresses, real money.
SHIPSTATION_PRODUCTION_API_KEY=
# Read-only unless true. With true, Buy label is charged to the account and Cancel / Void / Hold / Update change
# real shipments that other systems may be watching.
SHIPSTATION_PRODUCTION_WRITES=false

# --- Optional -------------------------------------------------------------------------------------------------
# Calls a minute this tool allows itself. Empty: the documented limit — 20 in the sandbox, 200 in production.
SHIPSTATION_RATE_LIMIT_PER_MINUTE=
# The port. Empty: 5190.
PORT=
